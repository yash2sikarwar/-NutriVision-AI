{
    "experimentalServices": {
        "frontend": {
            "root": "frontend",
            "routePrefix": "/",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "routePrefix": "/_/backend",
            "entrypoint": "server.js"
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/_/backend/api/:path*"
        },
        {
            "source": "/uploads/:path*",
            "destination": "/_/backend/uploads/:path*"
        }
    ]
}
